LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 聊天上下文与会话摘要（按实际模型窗口调整）
CHAT_CONTEXT_WINDOW_TOKENS=32768
CHAT_CONTEXT_MAX_OUTPUT_TOKENS=1200
CHAT_CONTEXT_SAFETY_BUFFER_TOKENS=2048
CHAT_CONTEXT_MAX_HISTORY_MESSAGES=500
CHAT_TOOL_AGENT_ENABLED=true
CHAT_TOOL_MAX_CALLS=4
CHAT_TOOL_TIMEOUT_SECONDS=15
CHAT_TOOL_RESULT_MAX_CHARS=6000
CHAT_SUMMARY_TRIGGER_TOKENS=6000
CHAT_SUMMARY_TRIGGER_MESSAGES=40
CHAT_SUMMARY_KEEP_RECENT_TOKENS=2000
CHAT_SUMMARY_MAX_OUTPUT_TOKENS=1200
CHAT_MICROCOMPACT_FULL_ARTIFACT_TOKENS=800
CHAT_MICROCOMPACT_TARGET_ARTIFACT_TOKENS=240
CHAT_MEMORY_EXTRACTION_ENABLED=true
CHAT_MEMORY_EXTRACTION_MAX_OUTPUT_TOKENS=800
CHAT_MEMORY_RECALL_LIMIT=12
CHAT_MEMORY_RECALL_CANDIDATE_LIMIT=100
CHAT_MEMORY_AUTO_CONFIRM_MIN_CONFIDENCE=0.8
MEMORY_RETRIEVAL_MODE=hybrid
MEMORY_VECTOR_ENABLED=true
MEMORY_EMBEDDING_MODEL=text-embedding-v3
MEMORY_VECTOR_COLLECTION=slim_agent_user_memory_v1
MEMORY_VECTOR_CANDIDATE_LIMIT=40
MEMORY_KEYWORD_CANDIDATE_LIMIT=100
MEMORY_HEALTH_RECALL_LIMIT=4
MEMORY_RRF_K=60
MEMORY_INDEX_BATCH_SIZE=20
MEMORY_INDEX_MAX_ATTEMPTS=5
MEMORY_INDEX_RETRY_BASE_SECONDS=5
# staging/production 必填，由反向代理注入 X-Memory-Access-Key，不能放进浏览器代码
MEMORY_API_ACCESS_KEY=

# 多模态视觉模型（食材识别/身材分析/动作分析/餐食识别）
VISION_MODEL=qwen-vl-plus

# DashScope 文生图
IMAGE_MODEL=wan2.6-t2i
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_GENERATION_ENABLED=true

DATABASE_URL=sqlite+aiosqlite:///./slim_agent.db

# 运行环境：development / staging / production
APP_ENV=development

# 知识库管理接口密钥（production 环境必须配置，development 可留空）
KNOWLEDGE_ADMIN_KEY=

# 允许的前端来源（逗号分隔），默认仅本地开发端口；部署时改为正式域名
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
